rules_version = '2';

// Dynamic Entry cloud saves.
// Each player can read and write only their own document, players/{their uid}.
// Nobody can list other players or touch anyone else's save.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'loadout', 'mvol', 'svol', 'updated'])
        && request.resource.data.save is map;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
